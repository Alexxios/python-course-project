# Local infrastructure defaults; copied to .env by just bootstrap.
# Pass --env-file .env when running Docker Compose from the workspace root.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432
REDIS_PORT=6379

# Learning platform Compose configuration. Standalone uv runs use exported variables.
APP_PORT=8000
QUIZ_GENERATOR=local
# Optional AI generation: set QUIZ_GENERATOR=openai and supply both values.
OPENAI_API_KEY=
OPENAI_MODEL=
